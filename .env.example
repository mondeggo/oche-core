# Optional: these values can also be entered through the CLI, UI or config/config.yaml.
# AutoDarts must assign OcheCore a client_id with the device grant enabled.
OCHECORE_CLIENT_ID=
OCHECORE_BOARD_ID=

# Current API origin (migrated from .io in 2026).
OCHECORE_API_BASE_URL=https://api.autodarts.com
OCHECORE_DATA_DIR=./data
OCHECORE_HOST=0.0.0.0
OCHECORE_PORT=9180
# Set false to serve only the API and event stream.
OCHECORE_UI_ENABLED=true

# Standard Docker startup publishes locally; scripts/dev.* default to all interfaces.
OCHECORE_PUBLISH_HOST=127.0.0.1
